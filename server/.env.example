# GuardNG API server configuration
# Copy to .env (never commit .env)

# MongoDB connection string (MongoDB Atlas free tier works)
MONGODB_URI=mongodb://localhost:27017/guardng

# Secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=change-me

# OpenRouter (server-side only — never expose to the client)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Comma-separated allowed origins for CORS (use your app origin in prod)
CORS_ORIGIN=*

PORT=4000

# Used by `npm run seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
